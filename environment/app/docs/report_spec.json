{
  "workflow_repair": {
    "path": "/app/workflow/reconcile_retention.py",
    "cli_usage": "python3 /app/workflow/reconcile_retention.py --input PATH --output-dir PATH",
    "defaults": {
      "input": "/app/data/snapshots.json",
      "output_dir": "/app/output",
      "retention_policy": "/app/data/retention_policy.json",
      "pin_registry": "/app/data/pin_registry.json"
    },
    "prohibited_imports": [
      "pandas", "numpy", "dateutil", "arrow", "pendulum", "pytz", "datetime", "calendar", "zoneinfo"
    ]
  },
  "output_files": {
    "summary_json": "summary.json",
    "retention_state_json": "retention_state.json",
    "retention_decisions_jsonl": "retention_decisions.jsonl",
    "additional_files_allowed": false
  },
  "field_types": {
    "snapshot_id": {"type": "string"},
    "repo": {"type": "string"},
    "vault": {"type": "string"},
    "ts": {
      "type": "integer",
      "unit": "epoch_seconds",
      "input_coercion": "int(str(ts).strip()); on failure int(float(str(ts).strip())); on failure 0"
    },
    "size_bytes": {
      "type": "integer",
      "input_coercion": "int(str(size_bytes).strip()); on failure int(float(str(size_bytes).strip())); on failure 0"
    },
    "pinned": {
      "type": "boolean",
      "input_coercion": "booleans unchanged; strings true/1/yes/pinned after str(...).strip().lower() -> true; other strings -> false; other types -> bool(value)"
    },
    "size_mb": {"type": "integer"},
    "held": {"type": "boolean"},
    "hold": {"type": "string", "enum": ["", "flag", "compliance", "legal", "manual"]},
    "daily_bucket": {"type": "integer"},
    "weekly_bucket": {"type": "integer"},
    "monthly_bucket": {"type": "integer"},
    "yearly_bucket": {"type": "integer"},
    "idle_gap": {"type": "integer"},
    "carry_in": {"type": "integer"},
    "used_quota": {"type": "integer"},
    "decision": {"type": "string", "enum": ["keep", "prune", "defer"]},
    "decision_counts": {"type": "object", "keys": ["keep", "prune", "defer"]},
    "roles": {
      "type": "array",
      "items": {"type": "string", "enum": ["daily", "weekly", "monthly", "yearly", "pinned"]}
    }
  },
  "retention_decisions_jsonl": {
    "output_path": "retention_decisions.jsonl",
    "container": "one compact JSON object per line, json.dumps(..., separators=(',', ':'))",
    "required_fields": [
      "snapshot_id", "repo", "vault", "ts", "size_bytes", "size_mb", "pinned", "held",
      "hold", "daily_bucket", "weekly_bucket", "monthly_bucket", "yearly_bucket",
      "roles", "decision", "idle_gap", "carry_in", "used_quota"
    ]
  },
  "retention_state_json": {
    "output_path": "retention_state.json",
    "container": "object keyed by normalized repo, each value an object with the keys below",
    "key_sort": "ascending",
    "required_fields": [
      "daily", "weekly", "monthly", "yearly", "pinned", "kept_count", "quota_used"
    ],
    "value_types": {
      "daily": {"type": "array", "items": "snapshot_id", "order": "ascending"},
      "weekly": {"type": "array", "items": "snapshot_id", "order": "ascending"},
      "monthly": {"type": "array", "items": "snapshot_id", "order": "ascending"},
      "yearly": {"type": "array", "items": "snapshot_id", "order": "ascending"},
      "pinned": {"type": "array", "items": "snapshot_id", "order": "ascending"},
      "kept_count": {"type": "integer"},
      "quota_used": {"type": "integer"}
    }
  },
  "summary_json": {
    "output_path": "summary.json",
    "container": "object",
    "schema_version": "retention-gfs-v1",
    "required_fields": [
      "schema_version", "raw_snapshot_count", "unique_snapshot_ids", "canonical_snapshot_count",
      "repo_count", "held_count", "decision_counts", "kept_count", "pruned_count",
      "deferred_count", "selected_bucket_count", "total_size_bytes", "kept_size_bytes",
      "reclaimed_size_bytes", "deferred_size_bytes", "max_quota_used"
    ],
    "decision_counts_key_order": ["keep", "prune", "defer"]
  },
  "policy_source": {
    "path": "/app/data/retention_policy.json",
    "shape": "{\"default\": {field: int, ...}, \"repo_overrides\": {repo: {field: int, ...}, ...}}",
    "fields": ["cap_daily", "cap_weekly", "cap_monthly", "cap_yearly", "quota_cap", "prune_cap"]
  },
  "pin_registry_source": {
    "path": "/app/data/pin_registry.json",
    "shape": "[{\"repo\": str, \"snapshot_id\": str, \"hold\": str, \"note\": str}, ...]"
  }
}
